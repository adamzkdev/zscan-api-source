# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me

# Public deployment (docker compose --profile prod up -d)
SITE_DOMAIN=zscan.cash
SITE_URL=https://zscan.cash

# Data sources (defaults: public zec.rocks lightwalletd + Tatum zebrad RPC)
# LWD_URL=https://zec.rocks:443,https://na.zec.rocks:443,https://eu.zec.rocks:443
# LWD_RATE_PER_SEC=50
# RPC_URL=https://zcash-mainnet-zebrad.gateway.tatum.io
# RPC_RATE_PER_MIN=4
# START_HEIGHT=3428143

# Inscriptions scan (NFTs from block 3,132,356; ZRC-20 token documents are skipped)
# INSCRIPTIONS=on
# INSCRIPTION_CONTENT_MAX=61200
# INSCRIPTION_BLOCKLIST=
# IPFS gateway for collection metadata and IPFS NFT images (relayed by the API)
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Public API rate limit per IP
# API_RATE_PER_SEC=10

# Host ports (bound to 127.0.0.1)
# WEB_PORT=3000
# API_PORT=8080
# DB_PORT=5433

# NU7 activation height, once announced (mainnet decision due 2026-10-20). Until zebra-chain
# ships NU7, this switches block timing to 25s and marks post-NU7 issuance as pending.
# NU7_ACTIVATION_HEIGHT=
# TESTNET_NU7_ACTIVATION_HEIGHT=

# Max concurrent WebSocket clients
# API_MAX_WS=2000
